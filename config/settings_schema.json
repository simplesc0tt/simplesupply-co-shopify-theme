[
  {
    "name": "theme_info",
    "theme_name": "Simpleton",
    "theme_version": "0.1.0",
    "theme_author": "SimpleScott",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "assistant_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "1240",
            "label": "Standard (1240px)"
          },
          {
            "value": "1440",
            "label": "Wide (1440px)"
          }
        ],
        "default": "1240"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#f4eeeb",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#000000",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "card_color",
        "default": "#ffffff",
        "label": "t:labels.card"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#000",
        "label": "t:labels.border"
      },
      {
        "type": "color",
        "id": "primary_color",
        "default": "#000000",
        "label": "t:labels.primary"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.social_media",
    "settings": [
      {
        "type": "header",
        "content": "t:general.social_media"
      },
      {
        "type": "url",
        "id": "social_facebook_url",
        "label": "Facebook",
        "info": "https://www.facebook.com/p/Simple-Supply-Co-61573788010048/"
      },
      {
        "type": "url",
        "id": "social_instagram_url",
        "label": "Instagram",
        "info": "https://www.instagram.com/simple_supply_co/?hl=en"
      },
      {
        "type": "url",
        "id": "social_twitter_url",
        "label": "Twitter",
        "info": "https://www.twitter.com/yourstore"
      },
      {
        "type": "url",
        "id": "social_youtube_url",
        "label": "YouTube",
        "info": "https://www.youtube.com/yourstore"
      }
    ]
  }
