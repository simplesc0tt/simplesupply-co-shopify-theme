<footer>
  <section>
  <div class="footer__newsletter">
    {% form 'customer', class: 'newsletter-form' %}
      {% if form.posted_successfully? %}
        <p class="newsletter-form__success">{{ 'newsletter.success' | t }}</p>
      {% endif %}

      <div class="newsletter-form__fields">
        <div><label for="newsletter-email" class="newsletter-form__label">
          {{ 'newsletter.label' | t }}
        </label></div>
        <div class="newsletter-form__input-wrapper">
          <input
            type="email"
            name="contact[email]"
            id="newsletter-email"
            class="newsletter-form__input"
            placeholder="{{ 'newsletter.placeholder' | t }}"
            required
          >
          <input type="hidden" name="contact[tags]" value="newsletter,subscribed-online">
        </div>
        <div>
            <button type="submit" class="newsletter-form__button">
            {{ 'newsletter.button' | t }}
        </button>
        </div>
      </div>

      {% if form.errors %}
        <p class="newsletter-form__error">{{ form.errors.messages['email'] }}</p>
      {% endif %}
    {% endform %}
  </div>
  </section>

  <div class="footer__links">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="social-links">
  _
    {% if settings.social_facebook_url != blank %}
      <a href="{{ settings.social_facebook_url }}" target="_blank" rel="noopener">Facebook</a>
    {% endif %}
    {% if settings.social_instagram_url != blank %}
      <a href="{{ settings.social_instagram_url }}" target="_blank" rel="noopener">Instagram</a>
    {% endif %}
    {% if settings.social_twitter_url != blank %}
      <a href="{{ settings.social_twitter_url }}" target="_blank" rel="noopener">Twitter</a>
    {% endif %}
    {% if settings.social_youtube_url != blank %}
      <a href="{{ settings.social_youtube_url }}" target="_blank" rel="noopener">YouTube</a>
    {% endif %}
    _
  </div>

  <div class="footer__copyright">
    &copy;
    {{ 'now' | date: '%Y' }}
    {{ shop.name | link_to: routes.root_url }}
  </div>




</footer>

{% stylesheet %}
  footer {
    text-transform: uppercase;
    padding-top: 40px !important;
    width:100%;
    margin:0px auto;
    max-width: 1240px;
  }
  footer a {
    text-decoration: none;
    color: var(--color-foreground);
  }
  footer .footer__links, footer .social-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  footer .footer__links {
    margin-top: 80px;
  }
  footer .social-links {
    margin-top: 1rem;
  }
  footer .footer_payment {
    display: flex;
    width: 100%;
    flex-direction: row;
    gap: 1rem;
  }
  footer .footer__copyright {
    margin: 30px 0px 40px 0px;
  }

  /* Newsletter form styles */
  .footer__newsletter {
    margin-bottom: 2rem;
    text-align: right;
  }
  .newsletter-form__label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: bold;
    font-family: "RingsideCompressed";
    font-style: normal;
    font-stretch: extra-condensed;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 24px;
  }
  .newsletter-form__input-wrapper {
    display: flex;
    gap: 0.5rem;
  }
  .newsletter-form__fields {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .newsletter-form__input {
    flex: 1;
    padding: 0.75rem;
    border: none;
    border-radius: var(--style-border-radius-inputs);
    font-family: "KansasCasual";
    font-style: normal;
    font-stretch: normal;
    font-weight: 500;
    font-size: 64px;
    text-align: right;
    background-color: var(--color-background);
  }
  .newsletter-form__button {
    padding: 0.75rem 1.5rem;
    background-color: var(--color-foreground);
    color: var(--color-background);
    border: none;
    border-radius: var(--style-border-radius-inputs);
    cursor: pointer;
    text-transform: uppercase;
  }
  .newsletter-form__button:hover {
    opacity: 0.8;
  }
  .newsletter-form__success {
    color: green;
    margin-bottom: 1rem;
  }
  .newsletter-form__error {
    color: red;
    margin-top: 0.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
