{% comment %}
  Product page for products with many variants (100+)
  Features:
  - Dropdown with color swatches, prices, and descriptions
  - Dynamic image swapping based on selected variant
  - Featured image remains static, other images swap
  - Support for multiple images per variant via metafields

  Metafield Setup:
  - Create a Metaobject Definition called "Product Variant Multiple Images"
  - Add a field called "images" (type: list of files)
  - Create entries for each variant with multiple images
  - Add metafield to Product Variants (type: metaobject reference)
  - Reference the metaobject entry from the variant
{% endcomment %}

<div class="product-featured-image" id="productFeaturedImage">
  {% if product.images.first %}
    {{ product.images.first | image_url: width: 1400 | image_tag }}
    {% assign featured_variant_name = '' %}
    {% for variant in product.variants %}
      {% if variant.featured_image.id == product.images.first.id %}
        {% assign featured_variant_name = variant.title %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if featured_variant_name != blank %}
      <div class="product-image__label">{{ featured_variant_name }}</div>
    {% endif %}
  {% endif %}
</div>

<div class="product-page">
  <div class="product-page__images" id="variantImages">
    {% comment %} Show all product images on initial load (except first/hero image) {% endcomment %}
    {% for image in product.images %}
      {% unless forloop.first %}
        {% comment %} Find which variant this image belongs to {% endcomment %}
        {% assign image_variant_name = '' %}
        {% assign image_variant_id = '' %}
        {% assign image_variant_available = false %}
        {% for variant in product.variants %}
          {% if variant.featured_image.id == image.id %}
            {% assign image_variant_name = variant.title %}
            {% assign image_variant_id = variant.id %}
            {% assign image_variant_available = variant.available %}
            {% break %}
          {% endif %}
        {% endfor %}

        <div class="product-image" data-variant-image="{{ image.id }}" data-variant-id="{{ image_variant_id }}">
          {{ image | image_url: width: 800 | image_tag }}
          {% if image_variant_name != blank %}
            <div class="product-image__label">
              {{ image_variant_name }}
            </div>
            {% if image_variant_available %}
              <button class="product-image__quick-add" data-variant-id="{{ image_variant_id }}">
                {{ 'products.quick_add' | t }}
              </button>
            {% endif %}
          {% endif %}
        </div>
      {% endunless %}
    {% endfor %}
  </div>

  <div class="product-page__info">
    <div class="product-info-sticky">
      <h2 class="product-title">{{ product.title }}</h2>

      <div class="product-form">
        {% form 'product', product %}
          {% assign current_variant = product.selected_or_first_available_variant %}

          {% if product.variants.size > 1 %}
            <div class="product-variants">

              <div class="mega-variant-select-wrapper">
                <select name="id" id="variantSelect" class="mega-variant-select">
                  <option value="" selected class="select-color-option">{{ 'products.select_color' | t }}</option>
                  <option value="see-all" class="see-all-option hidden">{{ 'products.see_all_colors' | t }}</option>
                  {% for variant in product.variants %}
                    {% if variant.available %}
                      <option
                        value="{{ variant.id }}"
                        data-variant-id="{{ variant.id }}"
                        data-variant-price="{{ variant.price | money }}"
                        data-variant-image-id="{{ variant.featured_image.id }}"
                        data-variant-color="{{ variant.option1 }}"
                      >
                        {{ variant.title }} - {{ variant.price | money }}
                      </option>
                    {% endif %}
                  {% endfor %}
                </select>
              </div>
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {% endif %}

          <div class="product-price" id="variantPrice">
            {% if product.price_varies %}
              <span class="price-range">{{ product.price_min | money }} - {{ product.price_max | money }}</span>
            {% else %}
              {{ product.price | money }}
            {% endif %}
          </div>

          <button type="submit" class="add-to-cart-button" id="addToCartButton" disabled>
            {{ 'products.add_to_cart' | t }}
          </button>
        {% endform %}
      </div>

      {% render 'product-description', product: product %}

      {% render 'product-meta', product: product %}
    </div>
  </div>
</div>

{% render 'related-products', product: product %}

{% comment %} Store variant data for JavaScript {% endcomment %}
<script>
  window.productVariants = {
    {% for variant in product.variants %}
      "{{ variant.id }}": {
        id: {{ variant.id }},
        title: "{{ variant.title | escape }}",
        price: "{{ variant.price | money }}",
        available: {{ variant.available }},
        featuredImageId: {{ variant.featured_image.id | json }},
        {% comment %} Get variant image IDs from metaobject reference {% endcomment %}
        imageIds: [
          {% if variant.featured_image.id %}
            {{ variant.featured_image.id }}{% if variant.metafields.custom.product_variant_images.value.images %},{% endif %}
          {% endif %}
          {% if variant.metafields.custom.product_variant_images.value.images %}
            {% for file in variant.metafields.custom.product_variant_images.value.images.value %}
              {{ file.id }}{% unless forloop.last %},{% endunless %}
            {% endfor %}
          {% endif %}
        ],
        {% comment %} Store metaobject images URLs for rendering {% endcomment %}
        metafieldImages: [
          {% if variant.metafields.custom.product_variant_images.value.images %}
            {% for file in variant.metafields.custom.product_variant_images.value.images.value %}
              {
                id: {{ file.id }},
                url: "{{ file | image_url: width: 800 }}",
                alt: "{{ variant.title | escape }}"
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          {% endif %}
        ],
        option1: "{{ variant.option1 | escape }}",
        option2: "{{ variant.option2 | escape }}",
        option3: "{{ variant.option3 | escape }}"
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  window.productImages = [
    {% for image in product.images %}
      {
        id: {{ image.id }},
        url: "{{ image | image_url: width: 800 }}",
        alt: "{{ image.alt | escape }}"
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  // Translation strings for JavaScript
  window.productTranslations = {
    quickAdd: "{{ 'products.quick_add' | t }}",
    adding: "{{ 'products.adding' | t }}",
    added: "{{ 'products.added' | t }}",
    error: "{{ 'products.error' | t }}",
    maxQuantity: "{{ 'products.max_quantity' | t }}",
    noMoreStock: "{{ 'products.no_more_stock' | t }}"
  };
</script>

{% stylesheet %}
  .product-featured-image {
    position: relative;
    width: 100%;
    max-width: 1240px;
    margin: 0 auto 2px auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    max-height: 70vh;
  }

  .product-featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    padding-top: 10px;
  }

  .product-page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    max-width: 1240px;
    margin: 0 auto;
  }

  .product-page__images {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .product-image {
    position: relative;
    width: 100%;
    background: #f5f5f5;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    transition: opacity 0.3s ease;
  }

  .product-image.hidden {
    display: none;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-image__label {
    position: absolute;
    bottom: 10px;
    left: 10px;
    background: rgba(255, 255, 255, 0.9);
    padding: 5px 12px;
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: bold;
    border: 1px solid #000;
  }

  .product-image__quick-add {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(255, 255, 255, 0.9);
    color: #000;
    border: 1px solid #000;
    padding: 5px 12px;
    font-family: var(--font-primary--family);
    font-size: 0.75rem;
    font-weight: bold;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease;
    z-index: 10;
  }

  .product-image__quick-add:hover:not(:disabled) {
    background: #000;
    color: #fff;
  }

  .product-image__quick-add:disabled {
    cursor: not-allowed;
  }

  .product-image__quick-add.loading {
    background: rgba(255, 255, 255, 0.9);
  }

  .product-image__quick-add.added {
    background: #000;
    color: #fff;
  }

  .product-page__info {
    position: relative;
  }

  .product-info-sticky {
    position: sticky;
    top: 0;
    padding: 150px 100px 100px 100px;
    background-color: #fff;
    min-height: 100vh;
  }

  .product-title {
    font-size: 2rem;
    line-height: 1;
    font-weight: bold;
    text-transform: uppercase;
    margin: 0 0 0.5rem 0;
  }



  .product-variants {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .variant-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: bold;
  }

  .mega-variant-select-wrapper {
    position: relative;
  }

  .mega-variant-select {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #000;
    font-size: 0.875rem;
    text-transform: uppercase;
    background-color: #fff;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.75rem center;
    background-size: 1.25rem;
    padding-right: 2.5rem;
  }

  .mega-variant-select:focus {
    outline: 2px solid #000;
    outline-offset: 2px;
  }

  .see-all-option.hidden,
  .select-color-option.hidden {
    display: none !important;
  }

  /* Initially hide "See all colors" */
  .see-all-option {
    display: none;
  }

  .product-page .product-price {
    font-size: 1.5rem;
    font-weight: bold;
    margin: 1.5rem 0 1.5rem 0;
  }

  .price-range {
    font-size: 1.25rem;
    font-weight: bold;
    margin: 1.5rem 0 1.5rem 0;
  }



  @media (max-width: 768px) {
    .product-page {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .product-info-sticky {
      position: static;
      padding: 20px;
    }

    .product-featured-image {
      aspect-ratio: 1 / 1;
    }

    .product-image__quick-add {
      right: 10px;
      padding: 10px 16px;
      font-size: 0.75rem;
    }
  }

  {% render 'product-styles' %}
{% endstylesheet %}

{% render 'product-description-toggle' %}

{% javascript %}
  // Helper function to update cart count in header
  function updateCartCount() {
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        const cartCountElement = document.getElementById('cart-count');
        if (cartCountElement) {
          cartCountElement.textContent = cart.item_count;
          if (cart.item_count > 0) {
            cartCountElement.style.display = '';
          } else {
            cartCountElement.style.display = 'none';
          }
        }
      })
      .catch(error => console.error('Error updating cart count:', error));
  }

  class MegaVariantSelector {
    constructor() {
      this.variantSelect = document.getElementById('variantSelect');
      this.priceElement = document.getElementById('variantPrice');
      this.addToCartButton = document.getElementById('addToCartButton');
      this.variantImagesContainer = document.getElementById('variantImages');
      this.seeAllOption = this.variantSelect?.querySelector('.see-all-option');
      this.selectColorOption = this.variantSelect?.querySelector('.select-color-option');
      this.allProductImages = this.getAllProductImages();
      this.processingButtons = new Set(); // Track which buttons are currently processing

      if (this.variantSelect) {
        this.init();
      }
    }

    getAllProductImages() {
      // Store initial state of all product images
      const images = [];
      if (this.variantImagesContainer) {
        const imageElements = this.variantImagesContainer.querySelectorAll('.product-image');
        imageElements.forEach(img => {
          images.push({
            html: img.outerHTML
          });
        });
      }
      return images;
    }

    init() {
      this.variantSelect.addEventListener('change', (e) => {
        this.handleVariantChange(e.target.value);
      });

      // Check if a variant is already selected (e.g., browser back button)
      const selectedVariantId = this.variantSelect.value;

      if (selectedVariantId && selectedVariantId !== '' && selectedVariantId !== 'see-all') {
        // A variant is pre-selected, trigger the change to update UI
        this.handleVariantChange(selectedVariantId);
      } else {
        // No variant selected on initial load
        if (this.addToCartButton) {
          this.addToCartButton.disabled = true;
          this.addToCartButton.textContent = 'Add to Cart';
        }

        // Price range is already showing from Liquid, no need to hide
      }
    }

    handleVariantChange(variantId) {
      // Handle "See all colors" or empty selection
      if (!variantId || variantId === 'see-all') {
        this.resetToAllImages();
        return;
      }

      const variant = window.productVariants[variantId];

      if (!variant) return;

      // Update price and show it
      if (this.priceElement) {
        this.priceElement.textContent = variant.price;
        this.priceElement.style.display = 'block';
      }

      // Update button state
      if (this.addToCartButton) {
        if (variant.available) {
          this.addToCartButton.disabled = false;
          this.addToCartButton.textContent = 'Add to Cart';
        } else {
          this.addToCartButton.disabled = true;
          this.addToCartButton.textContent = 'Sold Out';
        }
      }

      // Hide "Select a color" and show "See all colors" option
      if (this.selectColorOption) {
        this.selectColorOption.classList.add('hidden');
        this.selectColorOption.style.display = 'none';
      }
      if (this.seeAllOption) {
        this.seeAllOption.classList.remove('hidden');
        this.seeAllOption.style.display = 'block';
      }

      // Swap variant images
      this.swapVariantImages(variantId);
    }

    resetToAllImages() {
      // Show "Select a color" and hide "See all colors" option
      if (this.selectColorOption) {
        this.selectColorOption.classList.remove('hidden');
        this.selectColorOption.style.display = 'block';
      }
      if (this.seeAllOption) {
        this.seeAllOption.classList.add('hidden');
        this.seeAllOption.style.display = 'none';
      }

      // Reset to "Select a color"
      this.variantSelect.value = '';

      // Disable add to cart button
      if (this.addToCartButton) {
        this.addToCartButton.disabled = true;
        this.addToCartButton.textContent = 'Add to Cart';
      }

      // Reset to price range
      if (this.priceElement) {
        const priceRangeHTML = this.priceElement.querySelector('.price-range');
        if (priceRangeHTML) {
          // Already has price range, just make sure it's visible
          this.priceElement.style.display = 'block';
        }
      }

      // Restore all product images
      if (this.variantImagesContainer && this.allProductImages.length > 0) {
        this.variantImagesContainer.innerHTML = '';
        this.allProductImages.forEach(img => {
          this.variantImagesContainer.insertAdjacentHTML('beforeend', img.html);
        });
      }
    }

    swapVariantImages(variantId) {
      if (!this.variantImagesContainer) return;

      const variant = window.productVariants[variantId];
      if (!variant) return;

      console.log('Swapping to variant:', variant.title);
      console.log('Variant has metafield images:', variant.metafieldImages);

      // Clear all existing images
      this.variantImagesContainer.innerHTML = '';

      // Add featured image if it exists
      if (variant.featuredImageId) {
        const featuredImage = window.productImages.find(img => img.id === variant.featuredImageId);
        if (featuredImage) {
          this.renderImage(featuredImage, variant.title, variantId);
        }
      }

      // Add metafield images if they exist
      if (variant.metafieldImages && variant.metafieldImages.length > 0) {
        variant.metafieldImages.forEach(image => {
          this.renderImage(image, variant.title, variantId);
        });
      }
    }

    renderImage(image, variantTitle, variantId) {
      const imageDiv = document.createElement('div');
      imageDiv.className = 'product-image';
      if (variantId) {
        imageDiv.dataset.variantId = variantId;
      }

      const img = document.createElement('img');
      img.src = image.url;
      img.alt = image.alt || variantTitle;
      img.loading = 'lazy';

      const label = document.createElement('div');
      label.className = 'product-image__label';
      label.textContent = variantTitle;

      imageDiv.appendChild(img);
      imageDiv.appendChild(label);

      // Add quick-add button if variant ID exists and variant is available
      if (variantId) {
        const variant = window.productVariants[variantId];
        if (variant && variant.available) {
          const quickAddBtn = document.createElement('button');
          quickAddBtn.className = 'product-image__quick-add';
          quickAddBtn.dataset.variantId = variantId;
          quickAddBtn.textContent = window.productTranslations.quickAdd;

          // Attach click handler
          quickAddBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            // Find the ImageQuickAdd instance and call its handler
            // Or call the handler directly
            this.handleImageQuickAdd(quickAddBtn);
          });

          imageDiv.appendChild(quickAddBtn);
        }
      }

      this.variantImagesContainer.appendChild(imageDiv);
    }

    async handleImageQuickAdd(button) {
      const variantId = button.dataset.variantId;

      if (!variantId) {
        console.error('No variant ID found');
        return;
      }

      // Check if this button is already processing a request
      if (this.processingButtons.has(variantId)) {
        console.log('[Cart] Request already in progress for variant:', variantId);
        return;
      }

      // Mark this button as processing
      this.processingButtons.add(variantId);

      const originalText = button.textContent;
      button.disabled = true;
      button.classList.add('loading');
      button.textContent = window.productTranslations.adding;

      try {
        // First, get current cart to check if item already exists
        const cartResponse = await fetch('/cart.js');
        const cart = await cartResponse.json();

        // Find if this variant is already in cart
        const existingItem = cart.items.find(item => item.variant_id === parseInt(variantId));

        let response;
        if (existingItem) {
          // Item exists, increment quantity using change endpoint
          response = await fetch('/cart/change.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: existingItem.quantity + 1
            })
          });
        } else {
          // Item doesn't exist, add it
          response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              items: [{
                id: parseInt(variantId),
                quantity: 1
              }]
            })
          });
        }

        if (!response.ok) {
          const errorData = await response.json();
          console.error('[Cart] Failed to add variant:', {
            variantId,
            status: response.status,
            error: errorData
          });
          throw new Error(errorData.description || errorData.message || 'Failed to add to cart');
        }

        const data = await response.json();
        console.log('[Cart] Successfully added variant:', variantId);

        button.classList.remove('loading');
        button.classList.add('added');
        button.textContent = window.productTranslations.added;

        // Update cart count in header
        updateCartCount();

        document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
          bubbles: true
        }));

        setTimeout(() => {
          button.classList.remove('added');
          button.textContent = originalText;
          button.disabled = false;
          // Remove from processing set
          this.processingButtons.delete(variantId);
        }, 2000);

      } catch (error) {
        console.error('[Cart] Error adding variant to cart:', {
          variantId,
          error: error.message
        });

        button.classList.remove('loading');

        // Check for specific error messages
        const errorMessage = error.message.toLowerCase();
        if (errorMessage.includes('availability') || errorMessage.includes('stock') || errorMessage.includes('inventory')) {
          button.textContent = window.productTranslations.noMoreStock;
        } else if (errorMessage.includes('quantity') || errorMessage.includes('limit') || errorMessage.includes('maximum')) {
          button.textContent = window.productTranslations.maxQuantity;
        } else {
          button.textContent = window.productTranslations.error;
        }

        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
          // Remove from processing set
          this.processingButtons.delete(variantId);
        }, 2000);
      }
    }
  }

  // Quick Add functionality for product images
  class ImageQuickAdd {
    constructor() {
      this.processingButtons = new Set(); // Track which buttons are currently processing
      this.initQuickAddButtons();
    }

    initQuickAddButtons() {
      // Add event listeners to all current quick-add buttons
      const buttons = document.querySelectorAll('.product-image__quick-add');
      buttons.forEach(button => {
        button.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          this.handleQuickAdd(e.currentTarget);
        });
      });
    }

    async handleQuickAdd(button) {
      const variantId = button.dataset.variantId;

      if (!variantId) {
        console.error('No variant ID found');
        return;
      }

      // Check if this button is already processing a request
      if (this.processingButtons.has(variantId)) {
        console.log('[Cart] Request already in progress for variant:', variantId);
        return;
