<section class="feature-section">
    <div class="home-page-feature">
        <img src="/assets/placeholder-unsplash.jpg">
    </div>
    <div class="shop-description">
        Simple Supply Co. is where the creatively curious come to play. We're a supply shop for makers, dreamers, and even you doodlers out there — stocking everything from premium paints and drawing materials to the kind of stationery that makes you actually want to write things down. Quality pens that feel just right, sketchbooks begging to be filled, planners that might actually help you get organized, and those delightful little oddities that make you go "ooh, that's nice…"
    </div>
</section>

<section class="feature-collection">
    {% render 'featured-collection', collection: collections['the-new-now'] %}
</section>

<section>
    {% include 'featured-product' %}
</section>

<section class="categories-section">
    {% include 'collection-config' %}
    {% render 'sorted-parent-collections', collection_order: collection_order, layout: 'cards' %}
</section>
{% stylesheet %}

section {
    width:100%;
    margin:0px auto;
    max-width: 1240px;
    border-bottom: 1px solid #666666;
}

section.feature-section {
    padding-top: 20px;
    padding-bottom: 40px;
}

section.feature-collection {
    padding: 40px 0px;
}

.home-page-feature {
    background-color: #f5f5f5;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 0px auto 0px auto;
    max-width: 1240px;

}
.home-page-feature img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    position: relative;
}
.shop-description {
    width: 70%;
    max-width: 1240px;
    margin: 0px auto;
    padding: 30px 30px 0px 30px;
    text-transform: uppercase;
    color: #666666;
    line-height: 1.65em;
}

/* Categories Section */
.categories-section {
    padding: 40px 0;
}

.categories-title {
    font-size: 2rem;
    text-align: center;
    margin-bottom: 40px;
    text-transform: uppercase;
}
{% endstylesheet %}
