{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}


<section class="collection">
<div class="collection-header-image">
  {% if collection.image %}
    {{ collection.image | image_url: width: 1240 | image_tag: alt: collection.title }}
  {% else %}
    <div class="collection-header-image__placeholder"></div>
  {% endif %}
</div>
<!-- add a link to the parent collection if it exists -->
{% if collection.metafields.custom.parent_collection.value %}
  <div class="parent-collection-link">
    <a href="{{ collection.metafields.custom.parent_collection.value.url }}">
      ← {{ collection.metafields.custom.parent_collection.value.title }}
    </a>
  </div>
{% else %}
  <div class="parent-collection-link">
    <a href="/collections">
      ← {{ 'collections.all_collections' | t }}
    </a>
  </div>
{% endif %}

<h1>{{ collection.title }}</h1>
<p>{{ collection.description }}</p>

<!-- add a list of links to subcollections defined by the parent collection metafield -->
{% unless collection.handle == 'vendors' %}
  <div class="subcollections">
    {% for subcollection in collections %}
      {% if subcollection.metafields.custom.parent_collection.value.id == collection.id %}
        {{ subcollection.title | link_to: subcollection.url }}
      {% endif %}
    {% endfor %}
  </div>
{% endunless %}


<div class="collection-products">
  {% paginate collection.products by 20 %}
    {% for product in collection.products %}
      {% comment %} Skip products that are unavailable and not set to continue selling {% endcomment %}
      {% unless product.available == false and product.selected_or_first_available_variant.inventory_policy != 'continue' %}
      <div class="product-card">
        {% if product.featured_image %}
          <a href="{{ product.url }}" class="product-card__image">
            {{ product.featured_image | image_url: width: 400, height: 400 | image_tag: alt: product.title }}
          </a>
        {% else %}
          <a href="{{ product.url }}" class="product-card__image product-card__image--placeholder">
            <div class="product-card__placeholder"></div>
          </a>
        {% endif %}
        <div class="product-card__content">
          <h3>{{ product.title | link_to: product.url }}</h3>
          <p class="product-card__price">{{ product.price | money }}</p>
        </div>
      </div>
      {% endunless %}
    {% endfor %}

    <div class="pagination-wrapper">
      {{ paginate | default_pagination }}
    </div>
  {% endpaginate %}
</div>
</section>
{% stylesheet %}
  section .collection {
    padding: 0px;
  }
  .collection-header-image {
    width: 100%;
    max-width: 1240px;
    height: 60vh;
    margin: 20px auto 0px auto;
    overflow: hidden;
    background: #f5f5f5;
  }

  .collection-header-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-header-image__placeholder {
    width: 100%;
    height: 100%;
    background: #f5f5f5;
  }
  .collection h1 {
    font-size: 68px;
    margin: 2rem auto 0 auto;
  }
  .collection p {
    font-size: 1rem;
    margin: 0 auto 2rem auto;
  }
  .parent-collection-link {
    max-width: 1240px;
    margin: 20px auto 10px auto;
  }
  .parent-collection-link a {
    display: inline-block;
    padding: 8px 12px;
    text-decoration: none;
    color: #333;
    font-size: 0.875rem;
    text-transform: uppercase;
    font-weight: bold;
    transition: color 0.3s ease;
  }
  .parent-collection-link a:hover {
    color: #000;
    text-decoration: underline;
  }
  .collection-products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
  }
  .subcollections {
   margin: 30px 0px;
  }
  .subcollections a {
    display: flex-box;
    width: fit-content;
    padding: 10px;
    border: 1px solid #ccc;
    text-decoration: none;
    color: #333;
    transition: background-color 0.3s ease;
  }
  .subcollections a:hover {
    background-color: #f5f5f5;
  }

  @media (max-width: 1024px) {
    .collection-products {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .collection-products {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  .product-card {
    text-align: center;
  }

  .product-card__image {
    display: block;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }

  .product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    background: #ffffff;
    border-bottom: 1px solid #e5e5e5;
  }

  .product-card__image:hover img {
    transform: scale(1.05);
  }

  .product-card__content {
    text-align: left;
    padding: 15px;
    background-color: #fff;
    min-height: 100px;
  }

  .product-card__content h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    height: 42px;
  }

  .product-card__content h3 a {
    text-decoration: none;
    color: var(--color-foreground);
    font-family: "RingsideCompressed";
    font-style: normal;
    font-stretch: extra-condensed;
    font-weight: 700;
    text-transform: uppercase;
  }

  .product-card__content h3 a:hover {
    text-decoration: underline;
  }

  .product-card__price {
    font-weight: bold;
  }

  .pagination-wrapper {
    grid-column: 1 / -1;
    text-align: center;
    margin-top: 2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
