{% doc %}
  Shared product styles for description, meta, and common elements.
  Include this in both product.liquid and product-mega-variant.liquid.

  @example
  {% render 'product-styles' %}
{% enddoc %}

{% stylesheet %}
  .product-description {
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 2rem 0;
  }

  .product-description p {
    margin: 10px 0;
  }

  .product-description__toggle {
    background: none;
    border: none;
    color: #000;
    font-size: 0.875rem;
    font-family: var(--font-primary--family);
    font-weight: bold;
    text-transform: uppercase;
    cursor: pointer;
    padding: 0;
    margin-top: 1rem;
    text-decoration: underline;
    transition: opacity 0.2s ease;
  }

  .product-description__toggle:hover {
    opacity: 0.6;
  }

  .product-meta {
    font-size: 0.75rem;
    text-transform: uppercase;
    margin-bottom: 2rem;
    color: #666;
    line-height: 1.8;
  }

  .product-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .add-to-cart-button {
    color: #000;
    width: 100%;
    background: none;
    border-top: 1px solid #000;
    border-bottom: 1px solid #000;
    border-left: none;
    border-right: none;
    font-family: var(--font-primary--family);
    font-style: normal;
    font-stretch: normal;
    font-weight: 400;
    font-size: 1rem;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s;
    padding: 10px 0px;
  }

  .add-to-cart-button:hover:not(:disabled) {
    opacity: 0.8;
  }

  .add-to-cart-button:disabled {
    background: #ccc;
    cursor: not-allowed;
  }
{% endstylesheet %}
